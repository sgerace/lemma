{
    "format": "lemma-worksheet",
    "regions": [
        {
            "text": "Classical Mechanics",
            "type": "text",
            "width": 300,
            "x": 72,
            "y": 96
        },
        {
            "text": "A few classic results from a first mechanics course, derived with → and then put to numbers and plots. Regions calculate top to bottom, then left to right, so a name can be used anywhere below its definition. Every symbol is a positive real.",
            "type": "text",
            "width": 672,
            "x": 72,
            "y": 132
        },
        {
            "text": "Projectile Motion",
            "type": "text",
            "width": 300,
            "x": 72,
            "y": 228
        },
        {
            "text": "Launch at speed v and angle θ from the ground, with gravity g. Lemma knows g as standard gravity: it stays a letter in → results, and is 9.807 m/s² in numbers.",
